@inherits EditorComponentBase

@* Enum values + captions come from the item metadata (no fetch). BUG-012: an option's Value is the
   member NAME -- that is what OData sends in a row and what api/save accepts back
   (SaveReferenceAndEnumTests posts "Awaiting"). Current is matched through EnumValueCanon.Find so a row
   carrying the number instead still selects the right option. *@
<DxComboBox Data="@options" TData="Option" TValue="string"
            Value="@Selected"
            ValueChanged="@((string? v) => Set(v))"
            ValueFieldName="@nameof(Option.Value)"
            TextFieldName="@nameof(Option.Caption)"
            ReadOnly="@IsReadOnly"
            SearchMode="ListSearchMode.AutoSearch"
            NullText=" " />
@if (Error is not null) {
    <div class="text-danger small">@Error</div>
}

@code {
    public record Option(string Value, string Caption);
    List<Option> options = new();

    protected override void OnParametersSet() =>
        options = Node.Enum?.Select(e => new Option(OptionValue(e), e.Caption)).ToList() ?? new();

    string? Selected => Current is null ? null
        : Node.Enum is { } values && EnumValueCanon.Find(values, Current) is { } hit ? OptionValue(hit)
        : EnumValueCanon.Canonicalize(Current);

    static string OptionValue(EnumValueMetadata e) => e.Name ?? EnumValueCanon.Canonicalize(e.Value) ?? "";
}
