@inherits EditorComponentBase
@inject ApiClient Api

@* DxComboBox over api/lookup/{ObjectType} (PH2-005 / LOOKUP-001), the dedicated read-only candidate feed.
   It replaced a straight OData fetch of the target type's first 50 rows, which had two defects that were
   live in this very demo: Employee has 51 rows so one employee could never be picked, and if the object a
   record ALREADY referenced fell outside that window the combo rendered blank -- the editor could silently
   drop an existing value. Passing the current key makes the server include it unconditionally.

   Text comes from the SERVER, which walks the same display path the projector puts on the wire, so a combo
   and a grid cell agree on what an object is called (BUG-008).

   CEILING: search is still client-side over the fetched page. True server-side search means binding
   DxComboBox.CustomData, which speaks the DevExtreme.AspNet.Data LoadResult protocol (dxdocs, 26.1) and
   would change this endpoint's contract and add a package -- see LOOKUP-002. Until then the page is capped
   at the endpoint's own maximum, which covers every lookup target in this model.

   A failed fetch degrades to the raw key plus a badge, never crashing the form. *@
@if (loadError is not null) {
    <span class="text-muted">@Current</span>
    <span class="badge bg-secondary ms-2">lookup unavailable</span>
} else {
    <DxComboBox Data="@items" TData="LookupItem" TValue="object"
                Value="@Current"
                ValueChanged="@((object? v) => Set(v))"
                ValueFieldName="@nameof(LookupItem.Key)"
                TextFieldName="@nameof(LookupItem.Text)"
                ReadOnly="@IsReadOnly"
                SearchMode="ListSearchMode.AutoSearch"
                NullText=" " />
}
@if (Error is not null) {
    <div class="text-danger small">@Error</div>
}

@code {
    LookupItem[] items = [];
    string? loadError;

    protected override async Task OnInitializedAsync() {
        if (Node.Lookup is not { } lk) { loadError = "no lookup metadata"; return; }
        items = await Api.GetLookupItemsAsync(lk.ObjectType, key: Current?.ToString());
        // An empty feed for a member that HAS a value means the candidates failed to load; showing the raw
        // key beats showing an empty combo that looks like "no value set".
        if (items.Length == 0 && Current is not null) loadError = "candidates unavailable";
    }
}
