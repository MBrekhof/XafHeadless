@* Recursively renders one LayoutNode of a DetailView. Kinds: group -> section (fieldset when it has
   a caption, plain div otherwise), tabs/tab -> DxTabs/DxTabPage, item -> the mapped editor (or a
   MemberTemplate override, or an "unsupported editor" badge), nestedList -> a master-detail
   XafListView (Task 8's component, reused unchanged) scoped to the current detail object via
   State.ObjectKey. Captionless single-child wrapper groups are collapsed away first. *@
@using XafHeadless.Components.Components.Editors
@inject EditorMap EditorMap
@inject NavigationManager Navigation

@{ var node = DetailBinding.Unwrap(Node); }

@switch (node.Kind) {
    case "group":
        @if (!string.IsNullOrEmpty(node.Caption)) {
            @* No `rounded`: the Modernist system has zero radius everywhere. *@
            <fieldset class="xaf-group border p-2 mb-2">
                <legend class="fs-6 fw-bold w-auto mb-1">@node.Caption</legend>
                @Children(node)
            </fieldset>
        } else {
            <div class="xaf-group">@Children(node)</div>
        }
        break;

    case "tabs":
        <DxTabs>
            @foreach (var tab in node.Children ?? Enumerable.Empty<LayoutNode>()) {
                <DxTabPage Text="@(tab.Caption ?? "")">
                    <div class="pt-2">@Children(tab)</div>
                </DxTabPage>
            }
        </DxTabs>
        break;

    case "tab":
        @Children(node)   @* only reached if a tab is rendered outside a tabs group *@
        break;

    case "item":
        <div class="xaf-item mb-2">
            @* Label size/color come from the theme's `.xaf-item .form-label` (12px, 70% ink) --
               `text-muted small` would win over it with its own !important color. *@
            <label class="form-label">@node.Caption</label>
            @ItemEditor(node)
        </div>
        break;

    case "nestedList":
        <div class="xaf-nested-list my-2">
            @if (!string.IsNullOrEmpty(node.Caption)) { <div class="fw-bold small text-muted mb-1">@node.Caption</div> }
            @* CRUD-002: AGGREGATED (composite) children are owned by their master, so New/Delete is the
               right pair for them. A non-aggregated (shared) collection must use Link/Unlink instead --
               deleting there would destroy an object other records may still reference. That is GAP-010's
               distinction, and LayoutNode.Aggregated is projected precisely so the client can honour it. *@
            <XafListView ViewId="@(node.ViewId ?? "")" MasterKeyMember="@node.MasterKeyMember" MasterKey="@State.ObjectKey"
                         MasterKeyName="@State.KeyMember"
                         AllowRowDelete="@(node.Aggregated == true)"
                         OnNewRequested="@(node.Aggregated == true ? EventCallback.Factory.Create(this, () => NavigateToNew(node)) : default)"
                         OnRowSelected="@(key => NavigateToRow(node, key))" />
        </div>
        break;
}

@code {
    [Parameter] public LayoutNode Node { get; set; } = default!;
    [CascadingParameter] public DetailViewState State { get; set; } = default!;

    // BUG-009: nested row click -> that row's own detail view, taken from the projected DetailViewId.
    //
    // This used to reuse the "_ListView" -> "_DetailView" swap that ListPage.razor applies to a TOP-LEVEL
    // list, on the theory that it "falls out naturally". It does not: a nested view is named
    // {Master}_{Collection}_ListView, so Order_OrderItems_ListView became Order_OrderItems_DetailView --
    // a view that does not exist (404), while the child's real one is OrderItem_DetailView. Every nested
    // tab was affected; nothing caught it because the failure lands as the DetailView's "failed to load"
    // state after the click, and no test clicked a nested row.
    //
    // The old derivation stays only as the fallback for a host that predates DetailViewId.
    // CRUD-002: New on an AGGREGATED nested grid opens the child's own create form, carrying the master so
    // the new object is associated with the record the user clicked "New" inside. Without that hand-off the
    // form would create an orphan the user then has to re-parent by hand -- and for a composite child there
    // is no sensible way to do so, because its whole identity is "belongs to this master".
    //
    // Deliberately the full DetailView rather than an immediate blank row: a child type with required
    // members would simply 422 on a blank create, so "add a row then fill it in" only works for types that
    // happen to have no rules. A form works for every type.
    void NavigateToNew(LayoutNode node) {
        if (string.IsNullOrEmpty(node.DetailViewId) || string.IsNullOrEmpty(node.MasterKeyMember)) return;
        var query = $"?masterMember={Uri.EscapeDataString(node.MasterKeyMember)}" +
                    $"&masterKey={Uri.EscapeDataString(State.ObjectKey)}";
        Navigation.NavigateTo($"/new/{node.DetailViewId}{query}");
    }

    void NavigateToRow(LayoutNode node, string key) {
        var target = node.DetailViewId
            ?? node.ViewId?.Replace("_ListView", "_DetailView");
        if (string.IsNullOrEmpty(target)) return;
        Navigation.NavigateTo($"/detail/{target}/{key}");
    }

    RenderFragment Children(LayoutNode n) => @<text>
        @foreach (var child in n.Children ?? Enumerable.Empty<LayoutNode>()) {
            <LayoutNodeRenderer Node="child" />
        }
    </text>;

    RenderFragment ItemEditor(LayoutNode item) => builder => {
        var member = item.Member!;
        if (State.MemberTemplates.TryGetValue(member, out var template)) {
            builder.AddContent(0, template(State.Current(member)));
            return;
        }
        var type = EditorMap.Resolve(item);
        if (type is null) {
            builder.OpenElement(1, "div");
            builder.OpenElement(2, "span");
            builder.AddAttribute(3, "class", "text-muted");
            builder.AddContent(4, State.Current(member)?.ToString());
            builder.CloseElement();
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", "badge bg-warning text-dark ms-2");
            builder.AddContent(7, $"unsupported editor: {item.Editor}");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }
        builder.OpenComponent<DynamicComponent>(8);
        builder.AddAttribute(9, "Type", type);
        builder.AddAttribute(10, "Parameters", new Dictionary<string, object?> { ["Node"] = item });
        builder.CloseComponent();
    };
}
