@page "/reports"
@using XafHeadless.Components.Components

<PageTitle>Reports</PageTitle>

@* GAP-007 / BUG-013: AuthGuard defers rendering -- and therefore the catalogue fetch -- until the JWT is
   present, exactly as ListView and DetailPage do. A page-level OnInitializedAsync runs BEFORE the guard's
   child mounts, which is how the catalogue used to fetch unauthenticated on a hard refresh. *@
<AuthGuard>
    <ReportsPanel />
</AuthGuard>
