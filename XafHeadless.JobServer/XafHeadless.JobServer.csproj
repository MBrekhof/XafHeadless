<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The demo module ships a CA1416 (platform-specific) surface; it is read-only, so suppress. -->
    <NoWarn>CA1416;$(NoWarn)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- READ-ONLY reference to DevExpress's installed OutlookInspired demo module (26.1.4 / net10.0).
         Never modified. Provides OutlookInspiredModule (multi-tenant), OutlookInspiredEFCoreDbContext,
         and ReportDataV2 — the same reference XafHeadless.Api.csproj uses. -->
    <ProjectReference Include="$(OutlookInspiredModulePath)" />
  </ItemGroup>

  <ItemGroup>
    <!-- XAF Web API host baseline — versions match XafHeadless.Api.csproj (26.1.4 line). -->
    <PackageReference Include="DevExpress.ExpressApp.WebApi" Version="26.1.4" />
    <!-- Multi-tenancy on the standalone Web API builder: OutlookInspiredModule is intrinsically
         multi-tenant (its Updater resolves ITenantProvider), so AddMultiTenancy is mandatory. -->
    <PackageReference Include="DevExpress.ExpressApp.MultiTenancy.WebApi.EFCore" Version="26.1.4" />
    <!-- ReportsV2.Blazor DI-registers IReportExportService (Phase 3 render path); net library, no
         Blazor circuit is wired, so the host stays headless. -->
    <PackageReference Include="DevExpress.ExpressApp.ReportsV2.Blazor" Version="26.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <!-- XAF EF Core resolves design-time services at runtime in a headless host (matches the Api). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>none</PrivateAssets>
      <IncludeAssets>all</IncludeAssets>
    </PackageReference>
    <!-- Hangfire: SqlServer storage in XafHeadlessDemo's own "Hangfire" schema + the worker.
         Version 1.8.21 matches the companion headless implementation (the ported pattern's proven baseline). -->
    <PackageReference Include="Hangfire.Core" Version="1.8.21" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.21" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.21" />
    <!-- Task 4.1: MailKit-backed EmailService. Version matches the companion headless implementation (MimeKit rides
         along as MailKit's own dependency, no separate reference needed). -->
    <PackageReference Include="MailKit" Version="4.16.0" />
  </ItemGroup>

</Project>
