      "type": "text",
      "x": 350,
      "y": 184,
      "strokeColor": "#1e1e1e",
      "text": "multi-tenant XAF Web API host\nno UI · no circuits · async",
      "fontSize": 13,
      "fontFamily": 2,
      "createdAt": "2026-07-21T21:59:37.546Z",
      "updatedAt": "2026-07-21T21:59:37.546Z",
      "version": 1
    },
    {
      "id": "mrib4885mpofu7xuo1h",
      "type": "text",
      "x": 350,
      "y": 248,
      "strokeColor": "#1e1e1e",
      "text": "GET  /api/model/views · /navigation\nGET  /api/odata      (reads)\nPOST /api/save       (validated)\n        OData writes -> 405\n     /api/commands · /api/prefs\nsecurity: IsGranted, per request",
      "fontSize": 12,
      "fontFamily": 3,
      "createdAt": "2026-07-21T21:59:37.546Z",
      "updatedAt": "2026-07-21T21:59:37.546Z",
      "version": 1
    },
